#!/usr/bin/env bash
#
# cleanup.sh — free disk space by clearing regenerable caches and build output.
#
# Usage:
#   mise run cleanup            # standard cleanup (safe, everything regenerates)
#   mise run cleanup --check    # report sizes only, delete nothing
#   mise run cleanup --deep     # also go module cache, playwright browsers
#   mise run cleanup --repos    # also build artifacts under ~/go/src/github.com
#                           # (node_modules, rust target, .next, .terraform, …)
#
# Everything removed here is regenerated automatically on demand — no
# functionality or data is lost. Flags combine: mise run cleanup --deep --repos

set -euo pipefail

CHECK=0 DEEP=0 REPOS=0
for arg in "$@"; do
  case "$arg" in
    --check) CHECK=1 ;;
    --deep)  DEEP=1 ;;
    --repos) REPOS=1 ;;
    *) echo "unknown flag: $arg" >&2; exit 1 ;;
  esac
done

step() { printf '\n==> %s\n' "$1"; }
info() { printf '    %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }
# one failing cleaner (broken shim, daemon down, …) must not abort the rest
run()  { "$@" || info "warn: '$*' failed — continuing"; }

###############################################################################
# Report
###############################################################################

step "Disk usage before"
df -h / | tail -1

step "Cache sizes"
have docker && docker system df 2>/dev/null || true
du -sh \
  ~/.npm \
  ~/Library/pnpm/store \
  ~/Library/Caches/pnpm \
  ~/.bun/install/cache \
  ~/Library/Caches/Homebrew \
  ~/Library/Caches/pip \
  ~/Library/Caches/go-build \
  ~/go/pkg/mod \
  ~/.gradle/caches \
  ~/.cargo/registry \
  ~/Library/Caches/ms-playwright \
  ~/Library/Developer/Xcode/DerivedData \
  2>/dev/null | sort -rh || true

###############################################################################
# Finished agent workspaces
###############################################################################
# Parallel agent sessions leave clones and worktrees behind, and nothing owns
# their end of life — this is what actually filled the disk. A workspace is
# only removed when it can prove it holds nothing: no uncommitted changes, no
# stash, no commit that is not on a remote, and no git activity for
# CLEANUP_AGENT_DAYS. Anything that fails a check is kept and reported.
#
# ponytail: activity is judged by the mtime of .git/index, which every git
# command touches. A workspace being read but never git-touched for a week
# looks idle. Good enough; a cwd scan across all processes is the upgrade.

AGENT_DAYS="${CLEANUP_AGENT_DAYS:-7}"

# 0 = safe to remove, 1 = keep, 2 = not a git workspace (say nothing)
agent_workspace_state() {
  local d="$1" index
  index="$d/.git/index"                             # plain clone
  [ -f "$d/.git" ] && index="$d/.git"               # linked worktree
  [ -e "$index" ] || return 2

  # Idle test comes first: git status refreshes the index and would reset the
  # very mtime being read. GIT_OPTIONAL_LOCKS=0 keeps the reads below from
  # writing it either.
  [ -n "$(find "$index" -maxdepth 0 -mtime +"$AGENT_DAYS" 2>/dev/null)" ] || return 1

  [ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$d" status --porcelain 2>/dev/null)" ] || return 1
  [ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$d" stash list 2>/dev/null)" ] || return 1
  # every commit reachable from a local branch must also be on some remote
  [ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$d" log --branches --not --remotes --oneline 2>/dev/null)" ] || return 1
}

agent_workspace_cleanup() {
  step "Finished agent workspaces (clean, pushed, idle >${AGENT_DAYS}d)"
  found=0
  for d in ~/wt-* ~/agent-work-* ~/projects/cplt-*; do
    [ -d "$d" ] || continue
    agent_workspace_state "$d" && state=0 || state=$?
    [ "$state" -eq 2 ] && continue
    found=1
    if [ "$state" -eq 0 ]; then
      if [ "$CHECK" -eq 1 ]; then
        info "would remove: $d ($(du -shx "$d" 2>/dev/null | cut -f1))"
      else
        info "removing: $d ($(du -shx "$d" 2>/dev/null | cut -f1))"
        rm -rf "$d"
      fi
    else
      info "keeping: $d (has work, or active within ${AGENT_DAYS}d)"
    fi
  done
  if [ "$found" -eq 0 ]; then
    info "no agent workspaces found"
  fi

  step "Stale build output in live workspaces (idle >${AGENT_DAYS}d)"
  # Source is untouched; only rebuildable output goes. A workspace still in use
  # keeps a fresh mtime on its output and is skipped.
  for out in ~/projects/*/target ~/projects/*/node_modules ~/wt-*/target; do
    [ -d "$out" ] || continue
    if [ -n "$(find "$out" -maxdepth 0 -mtime +"$AGENT_DAYS" 2>/dev/null)" ]; then
      if [ "$CHECK" -eq 1 ]; then
        info "would remove: $out ($(du -shx "$out" 2>/dev/null | cut -f1))"
      else
        info "removing: $out ($(du -shx "$out" 2>/dev/null | cut -f1))"
        rm -rf "$out"
      fi
    fi
  done
}

if [ "$CHECK" -eq 1 ]; then
  agent_workspace_cleanup
  info "--check: stopping before any deletion"
  exit 0
fi

###############################################################################
# Standard cleanup — always safe
###############################################################################

step "Docker"
if have docker && docker info >/dev/null 2>&1; then
  run docker system prune -a -f --volumes   # unused images, stopped containers, anon volumes
  run docker builder prune -a -f            # build cache
else
  info "docker not running — skipping"
fi

step "JavaScript package caches"
! have npm  || run npm cache clean --force
! have pnpm || run pnpm store prune
! have yarn || run yarn cache clean
! have bun  || run bun pm cache rm

step "Homebrew"
! have brew || run brew cleanup --prune=all

step "Python caches"
! have pip3 || run pip3 cache purge
! have uv   || run uv cache clean

step "Go build cache"
! have go || run go clean -cache

step "Gradle & Maven caches"
rm -rf ~/.gradle/caches

step "mise (unused tool versions + download cache)"
if have mise; then
  mise prune --yes 2>/dev/null || mise prune -y 2>/dev/null || true
  mise cache clear
fi

step "Xcode"
rm -rf ~/Library/Developer/Xcode/DerivedData
! have xcrun || run xcrun simctl delete unavailable

step "AI Agent caches & uploads"
rm -rf ~/.claude/{uploads,cache,paste-cache,shell-snapshots,debug} 2>/dev/null || true
rm -rf ~/.gemini/antigravity-cli/{cache,log,crashes} 2>/dev/null || true
rm -rf ~/.copilot/{logs,run} 2>/dev/null || true
rm -rf ~/.copilot/session-state/*/{files,checkpoints,rewind-snapshots} 2>/dev/null || true

step "Old temp files (/private/tmp, >3 days, own user only)"
# live sessions keep recent mtimes and are never touched; macOS wipes the
# rest on reboot anyway — this just brings that forward
find /private/tmp -mindepth 1 -maxdepth 1 -user "$(id -un)" -mtime +3 \
  -exec rm -rf {} + 2>/dev/null || true

###############################################################################
# --deep: heavier caches (regenerate via re-download, slower first use)
###############################################################################

if [ "$DEEP" -eq 1 ]; then
  step "Go module cache (--deep)"
  ! have go || run go clean -modcache

  step "Playwright browsers (--deep)"
  rm -rf ~/Library/Caches/ms-playwright
fi

###############################################################################
# --repos: build artifacts inside ~/go/src/github.com working trees
###############################################################################

if [ "$REPOS" -eq 1 ]; then
  step "Repo build artifacts across all workspaces (--repos)"
  # Target all known workspaces, silencing errors if they don't exist yet
  find ~/go ~/copilot ~/copilot-worktrees ~/mlx-workspace ~/examples ~/minmal-maven \
    -name .git -prune -o -type d \
    \( -name node_modules -o -name target -o -name .next -o -name .terraform \
       -o -name .tofu-plugin-cache -o -name .venv -o -name venv -o -name __pycache__ \
       -o -name .pytest_cache -o -name .svelte-kit -o -name .turbo -o -name .gradle \
       -o -name storybook-static -o -name .docusaurus \) -prune -print0 2>/dev/null \
    | xargs -0 rm -rf
fi

agent_workspace_cleanup

###############################################################################

step "Disk usage after"
df -h / | tail -1
info "done — everything removed regenerates automatically on demand"
