#!/usr/bin/env bash
#
# tmux-sessions — create the working sessions if they are not already there.
#
# Idempotent: an existing session is left exactly as it is, so this is safe to
# run from tmux.conf on every config load and by hand after a reboot.
#
# Sessions are named after the work, not the directory, because that is what
# `claude remote-control <name>` and `tmux attach -t <name>` are typed against.

set -euo pipefail

# session:directory
# "Default" is not listed: tmux.conf creates it itself on server start, and
# racing it here fails with "duplicate session".
# Started in each new session. Kept in one place so the flags stay in sync.
AGENT_CMD="claude remote-control --spawn same-dir"

SESSIONS=(
  # "dev" is deliberately absent: config.fish runs `tmux attach -t dev; or
  # tmux new -s dev` on ssh login. Creating it here first makes that command
  # fail with "duplicate session" and the login ends up with no server at all.
  "personal:$HOME/projects/personal"
  "konf:$HOME/projects/konf"
  "cplt:$HOME/projects/copilot"
  "nais-apm:$HOME/projects/nais-apm"
  "nav-patterns:$HOME/projects/nav-patterns"
  "unleash:$HOME/projects/unleash"
)

for entry in "${SESSIONS[@]}"; do
  name="${entry%%:*}"
  dir="${entry#*:}"
  tmux has-session -t "=$name" 2>/dev/null && continue
  [ -d "$dir" ] || { printf 'skipping %s: %s missing\n' "$name" "$dir" >&2; continue; }
  # tmux.conf runs this script itself on server start, so a manual run can race
  # it; losing that race is fine as long as the session ends up existing. Any
  # other failure is reported and does not stop the remaining sessions.
  if tmux new-session -d -s "$name" -c "$dir" 2>/dev/null; then
    # Start the agent in the session we just made. send-keys rather than a pane
    # command, so the pane keeps its shell when claude exits.
    #
    # --spawn same-dir is not optional: without it the CLI asks "Choose [1/2]"
    # and every session would sit at that prompt after a reboot. --name makes
    # the session show up under the tmux name in claude.ai/code.
    tmux send-keys -t "$name" "$AGENT_CMD --name $name" Enter
  elif ! tmux has-session -t "=$name" 2>/dev/null; then
    printf 'could not create %s\n' "$name" >&2
  fi
done
