{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "experimental": {
    "openTelemetry": true
  },
  "logLevel": "INFO",
  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.3-codex": {
          "limit": {
            "context": 272000,
            "input": 256000,
            "output": 16000
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 200000,
            "input": 184000,
            "output": 16000
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 272000,
            "input": 256000,
            "output": 16000
          }
        },
        "gpt-6-luna": {
          "limit": {
            "context": 272000,
            "input": 256000,
            "output": 16000
          }
        },
        "gpt-6-sol": {
          "limit": {
            "context": 272000,
            "input": 256000,
            "output": 16000
          }
        },
        "gpt-6.1-sol": {
          "limit": {
            "context": 272000,
            "input": 256000,
            "output": 16000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 24000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "plugin": [
    "@dietrichgebert/ponytail@4.9.0"
  ],
  "share": "disabled"
}
